# BioBuddy Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# AI/ML API Keys
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# Create a new secret key and copy it here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Custom Search API (for image fallback)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Create a Custom Search Engine at: https://programmablesearchengine.google.com/controlpanel/all
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Database Configuration
DATABASE_URL=your_database_url_here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional: External Services
# CONCEPT_MAP_API_URL=your_concept_map_service_url
# ANALYTICS_API_KEY=your_analytics_key

# Formspree Configuration
# Get your Formspree form ID from: https://formspree.io/forms
# Create a new form and copy the form ID (the part after /f/ in the endpoint URL)
# Example: If your endpoint is https://formspree.io/f/abc123xyz, then FORM_ID=abc123xyz
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id_here

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Lemon Squeezy Payment Configuration
# Get these from your Lemon Squeezy account
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_LIFETIME_VARIANT_ID=your_lifetime_variant_id_here
LEMONSQUEEZY_MONTHLY_VARIANT_ID=your_monthly_variant_id_here

# Public Lemon Squeezy Checkout URLs
NEXT_PUBLIC_LEMONSQUEEZY_LIFETIME_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxx
NEXT_PUBLIC_LEMONSQUEEZY_MONTHLY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxx

